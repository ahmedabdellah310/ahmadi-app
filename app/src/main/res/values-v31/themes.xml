<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Android 12+ draws its own launch splash first; give it the night sky's colour so it
         hands over to Emran's animated splash without a grey flash. -->
    <style name="Theme.Emran" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/window_night_sky</item>
        <!-- Emran draws its own day and night (the sky). HyperOS/MIUI "dark mode for apps" would darken it again on
             top (cream turned grey, light pages muddy), so the system must never force-dark this app. -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:windowSplashScreenBackground">#FF071626</item>
        <!-- No icon in the system splash: Emran's own tile springs in right after it, so a still icon would pop twice. -->
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
